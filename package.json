{
  "name": "homeos",
  "version": "1.0.0",
  "private": true,
  "description": "HomeOS — local-first household & personal operating system",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "start:https": "node scripts/serve-https.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "reference:build": "node scripts/build-usda-reference.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test --trace off",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tesseract.js": "^7.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.33"
  },
  "engines": {
    "node": ">=20"
  }
}
